{
  "schema_version": "1.0",
  "project": "aqi-anomaly-dashboard",
  "repetitions": 3,
  "thresholds": {"warning_regression_percent": 20, "blocker_regression_percent": 50},
  "benchmarks": [
    {
      "id": "dashboard_data", "description": "Cold/warm dashboard artifact loading and scope construction",
      "timeout_seconds": 60, "command": ["{python}", "-m", "src.benchmark_dashboard"]
    },
    {
      "id": "sample_pipeline", "description": "Complete deterministic sample pipeline",
      "timeout_seconds": 600, "command": ["{python}", "run_all.py", "--mode", "sample"]
    },
    {
      "id": "app_test", "description": "Streamlit AppTest user journeys",
      "timeout_seconds": 180, "command": ["{python}", "-W", "error", "-m", "pytest", "-q", "-p", "no:cacheprovider", "--basetemp", "{temp}/pytest", "tests/test_app_user_journey.py"]
    },
    {
      "id": "browser_qa", "description": "Browser QA across six routes and three viewports",
      "timeout_seconds": 600, "command": ["{python}", "quality/run_acceptance.py", "ui"]
    }
  ]
}
